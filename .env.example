# Copy to .env.local (local) and add the same keys in Vercel -> Settings -> Environment Variables.

# MongoDB. Local dev: run `npm run db:local` and keep this value.
# Production: your Atlas connection string, e.g. mongodb+srv://user:pass@cluster0.xxxxx.mongodb.net/sunpower
MONGODB_URI=mongodb://127.0.0.1:27017/sunpower?directConnection=true

# Auth.js secret. Generate one with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET=

# PostHog (free tier) - optional; analytics are disabled when empty.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
